{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Cl\u00e9 de configuration (ex: stripe_test_mode)"
    },
    "value": {
      "type": "boolean",
      "default": false,
      "description": "Valeur de la configuration"
    },
    "description": {
      "type": "string",
      "description": "Description pour l'admin"
    }
  },
  "required": [
    "key",
    "value"
  ]
}